# Copy this file to .env and add your own Razorpay Test Mode credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the same secret configured for your Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# Optional: used once by `python manage.py bootstrap_superuser` on first deployment.
# Remove the password from the hosting environment after the admin is created.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
